{
  "name": "dsh-mail",
  "version": "0.1.0",
  "private": true,
  "description": "DSH plugin: talk to your running DeepSeek Harness sessions by email (away mode, session-tagged subjects, inbound replies injected into the original session)",
  "type": "module",
  "main": "lib/index.js",
  "exports": {
    ".": {
      "default": "./lib/index.js"
    },
    "./client": {
      "default": "./lib/client.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "lib/index.js",
    "lib/host.js",
    "lib/client.js",
    "README.md"
  ],
  "scripts": {
    "build": "node scripts/build.mjs",
    "test": "node --test test/*.test.mjs"
  },
  "keywords": [
    "dsh-plugin",
    "email",
    "imap",
    "smtp"
  ],
  "dsh": {
    "client": {
      "platform": "web",
      "inject": [
        "@deepseek-ai/dsh-client-connection",
        "@deepseek-ai/dsh-api-remotes",
        "@deepseek-ai/dsh-client-ui-renderer",
        "@deepseek-ai/dsh-client-ui-sidebar"
      ]
    }
  },
  "license": "MIT",
  "devDependencies": {
    "esbuild": "^0.28.2",
    "imapflow": "^2.2.1",
    "mailparser": "^3.9.33",
    "nodemailer": "^10.0.13"
  }
}
